  QueueTurnEnd.TurnEndRequest
  Report.{ FlowId Event }
  Lock.{ Sender Recipient }
  Bind.{ Address Process }
  Identify.Process
  Deliver.{ Lock Request }
  Release.Lock
  End.Address
  Current.Address
  Metaflows ]
[ Started.Launched
  LaunchPending.LaunchAttempt
  StartAmbiguous.PromptDeliveryIntent
